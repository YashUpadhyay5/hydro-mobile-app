# Copy this file to .env.local (git-ignored) and fill it in. Metro inlines EXPO_PUBLIC_* values into the
# bundle at build time, so they are visible in the app: never put secrets here.
# After changing a value, restart with `npx expo start --clear`.

# Base URL of the HRMS backend the app talks to. "/api" is appended if you leave it off.
# A phone or emulator cannot reach "localhost" on your computer, so use the computer's LAN IP
# (run `ipconfig` on Windows and read the IPv4 address) or a tunnel / hosted URL.
EXPO_PUBLIC_API_URL=http://<your-computer-lan-ip>:8000/api

# Support contacts shown on the Help & Support screen. Leave unset to hide those buttons.
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_SUPPORT_PHONE=
